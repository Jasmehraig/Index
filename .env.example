# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# Public HTTPS base URL where this app is reachable (used for the Mini App button
# and the Telegram webhook). For local testing use an ngrok/cloudflared tunnel.
# The Mini App itself must be served over HTTPS for Telegram to open it.
PUBLIC_BASE_URL=https://your-public-host.example.com

# Optional: a fixed secret used to verify Telegram webhook calls.
# Leave empty to disable verification (dev only).
WEBHOOK_SECRET=

# SQLite database location
DATABASE_URL=sqlite:///./data/index.db

# Background RSS polling interval in minutes
POLL_INTERVAL_MINUTES=15

# AniList GraphQL endpoint (primary metadata provider, no key required)
ANILIST_URL=https://graphql.anilist.co

# Jikan (MyAnimeList) API base used as a metadata fallback
JIKAN_BASE_URL=https://api.jikan.moe/v4

# RSS bridge templates used to discover a channel feed, comma separated.
# {username} and {chat_id} are substituted. Public RSSHub instances are
# rate limited; point these at a self-hosted RSSHub for reliability.
RSS_PROVIDERS=https://rsshub.app/telegram/channel/{username},https://rsshub.rssforever.com/telegram/channel/{username}

# Optional: require this secret (sent as X-Admin-Token) for admin endpoints
ADMIN_TOKEN=

# Comma separated Telegram user ids allowed to run /refresh and /rss.
# Channel owners (whoever added the bot) are always allowed.
ADMIN_USER_IDS=

# Optional: channel/chat id where the bot announces newly indexed anime
ANNOUNCE_CHAT_ID=

# Curated "index" channels whose posts list anime names + links instead of
# release files. Comma separated chat ids or @usernames. These are always
# treated as index channels, even before the bot sees a name+link post.
INDEX_CHANNELS=
